# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env — never commit the real file.
#   cp .env.example .env
# The local stack runs entirely on emulators; the only value you may want to set
# is a Gemini API key. Without one the skeleton still runs, it just skips the
# model calls (VIGIL_MODEL_ENABLED=false behaviour).
# ─────────────────────────────────────────────────────────────────────────────

VIGIL_ENV=local
GOOGLE_CLOUD_PROJECT=vigil-local
GOOGLE_CLOUD_REGION=us-central1

# Vertex model serving location. NOT the same as the region above.
# Regional endpoints (us-central1, us-east5, ...) only serve up to Gemini 2.5;
# every 3.x model 404s there. Gemini 3.5+ is served from `global` only — and the
# hackathon mandates 3.5 or newer, so this must stay `global` on Vertex.
# Cloud Run and Firestore still use GOOGLE_CLOUD_REGION.
GOOGLE_CLOUD_LOCATION=global

# ── Emulators (match docker-compose.yml; unset these to hit real GCP) ────────
FIRESTORE_EMULATOR_HOST=localhost:8080
PUBSUB_EMULATOR_HOST=localhost:8085
STORAGE_EMULATOR_HOST=http://localhost:4443

# ── Telemetry → Jaeger locally, Cloud Trace in production ───────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=vigil

# ── Model access ────────────────────────────────────────────────────────────
# Two ways in. Pick ONE:
#   (a) Gemini API  — set GOOGLE_API_KEY, leave GOOGLE_GENAI_USE_VERTEXAI=false
#   (b) Vertex AI   — set GOOGLE_GENAI_USE_VERTEXAI=true and authenticate with
#                     `gcloud auth application-default login`
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_API_KEY=

# Verified against the live API on 2026-08-11 with `make models`.
#
# The rules require Gemini 3.5 or newer. Two findings worth keeping:
#   - gemini-3.5-pro does not exist. The only pro-class model on this key is
#     gemini-3.1-pro-preview, and 3.1 is OLDER than 3.5 — using it would fail
#     the mandatory requirement.
#   - gemini-pro-latest is an alias, so its version cannot be evidenced in a
#     compliance table. Explicit ids only.
# So the deep tier is the newest explicit model available rather than a pro one.
VIGIL_MODEL_FAST=gemini-3.5-flash
VIGIL_MODEL_DEEP=gemini-3.6-flash

# ── Runaway-agent defence. All three layers are described in the README; these
#    are layer 1. Layer 2 is Cloud Run --max-instances, layer 3 is budget alerts.
VIGIL_MAX_STEPS=25
VIGIL_MAX_TOOL_CALLS=40
VIGIL_MAX_TOKENS_PER_RUN=200000

# ── Topics / buckets ────────────────────────────────────────────────────────
VIGIL_TOPIC_EVENTS=vigil.events.clean
VIGIL_TOPIC_DLQ=vigil.events.dead
VIGIL_SUBSCRIPTION_WORKER=vigil.worker
VIGIL_BUCKET_RAW=vigil-raw

# ── API auth. Protects the public Cloud Run URL so stray traffic can't burn
#    credits. Generate one: python -c "import secrets;print(secrets.token_urlsafe(32))"
VIGIL_API_KEY=dev-local-key-change-me
